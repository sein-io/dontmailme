# The `agents` devDependency (Cloudflare Worker entry, src/worker.ts) peer-requires zod ^4,
# while the server itself is on zod ^3.25 together with @modelcontextprotocol/sdk.
# Without this, a plain `npm install` fails with ERESOLVE and contributors are stuck.
# Drop this line once both sides agree on one zod major.
legacy-peer-deps=true
