---
import Base from '../layouts/Base.astro';

const title = 'Free Up Gmail Storage Without Paying for Google One | DontMailMe';
const description =
  "Out of Google storage? Stop paying for Google One. Auto-unsubscribe from the junk newsletters filling your 15 GB — then bulk-delete what's already there. A free, open-source way to reclaim Gmail space.";

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dontmailme.org/' },
    { '@type': 'ListItem', position: 2, name: 'Free up Gmail storage', item: 'https://dontmailme.org/free-gmail-storage' },
  ],
};

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to free up Gmail storage without paying for Google One',
  description:
    'Reclaim Google storage for free by stopping the junk newsletters that fill it and bulk-deleting the mail you already have.',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'EUR', value: '0' },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Stop the inflow',
      text: 'Set up DontMailMe to auto-unsubscribe from the newsletters that keep arriving, so your storage stops filling up in the first place.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: "Clear what's already there",
      text: 'In Gmail, search category:promotions older_than:1y or larger:10M, select all, delete, then empty your Trash and Spam — only permanently deleted mail frees space.',
    },
  ],
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Will unsubscribing free up my Google storage?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Unsubscribing stops new newsletters from filling your shared 15 GB Google limit, so it prevents future storage growth. To reclaim space you've already used, you also need to delete old mail and empty your Trash and Spam — only permanently deleted mail frees storage, per Google.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do I free up Gmail storage for free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'First stop the junk arriving by auto-unsubscribing from newsletters. Then, in Gmail, search category:promotions older_than:1y or larger:10M, delete those messages, and empty your Trash and Spam folders. This reclaims space without paying for Google One.',
      },
    },
  ],
};
---
<Base title={title} description={description} path="/free-gmail-storage">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howTo)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
  </Fragment>

  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">›</span>Free up Gmail storage</nav>

  <article class="page">
    <div class="page-head">
      <h1>Free up Gmail storage — without paying for Google One</h1>
      <p class="lead">Your Google account gives you 15 GB shared across Gmail, Drive and Photos. Newsletters you never open quietly eat it. Here's how to win the space back — for free.</p>
    </div>

    <div class="prose">
      <h2>Step 1: Stop the inflow (the part everyone forgets)</h2>
      <p>Deleting old mail is treating the symptom. The junk keeps coming back next week. The real fix is to <strong>stop the newsletters at the source</strong> — which is exactly what DontMailMe does. It runs a free script inside your own Gmail that auto-unsubscribes you from the lists you never read, so your storage stops filling up in the first place.</p>
      <p><a href="/gmail" class="btn btn-primary">Set up auto-unsubscribe — free</a></p>

      <h2>Step 2: Clear what's already there</h2>
      <p>To reclaim space you've already lost, delete the bulk of old, heavy mail. In the Gmail search box, try these one at a time, select all, and delete:</p>
      <ul>
        <li><code>category:promotions older_than:1y</code> — a year of promotional clutter</li>
        <li><code>larger:10M</code> — the big attachments quietly hogging gigabytes</li>
        <li><code>from:(noreply) older_than:6m</code> — automated mail you'll never re-read</li>
      </ul>
      <p>Then <strong>empty your Trash and Spam folders</strong>. This is the step most people miss: deleted mail sits in Trash for 30 days and still counts against your quota. Only <em>permanently</em> deleted mail actually frees space (per Google).</p>

      <h2>An honest note</h2>
      <p>Unsubscribing prevents <em>future</em> storage growth; the bulk-delete above reclaims what you've already used. Do both once and you'll likely never see the "storage full" warning again — and you won't be paying Google a monthly fee to store mail you never wanted. <a href="/impact">See the full impact and methodology</a>.</p>
    </div>

    <div class="faq" style="margin-top:48px;">
      <details class="faq-item" open>
        <summary>Will unsubscribing free up my Google storage?</summary>
        <div class="answer">Unsubscribing stops new newsletters from filling your shared 15 GB Google limit, so it prevents future storage growth. To reclaim space you've already used, you also need to delete old mail and empty your Trash and Spam — only permanently deleted mail frees storage, per Google.</div>
      </details>
      <details class="faq-item">
        <summary>How do I free up Gmail storage for free?</summary>
        <div class="answer">First stop the junk arriving by auto-unsubscribing from newsletters. Then, in Gmail, search <code>category:promotions older_than:1y</code> or <code>larger:10M</code>, delete those messages, and empty your Trash and Spam folders. This reclaims space without paying for Google One.</div>
      </details>
    </div>

    <div class="cta-row" style="margin-top:40px;">
      <a href="/gmail" class="btn btn-primary">Stop the junk — free</a>
      <a href="/faq" class="btn">More questions</a>
    </div>
  </article>
</Base>
