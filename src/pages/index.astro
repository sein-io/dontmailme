---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const title = 'Auto-Unsubscribe From All Newsletters — Free, Open-Source, Zero-Data | DontMailMe';
const description =
  'Reach inbox zero and keep it there. DontMailMe auto-unsubscribes you from newsletters you never read with a free, open-source script that runs inside your own Gmail or Outlook — there is no server, so nothing ever leaves your account. RFC 8058, agent-ready, plants trees.';

// Native setup tracks + Tier-A providers (honest status). Full directory: roadmap.
const nativeProviders = ['Gmail', 'Outlook', 'Apple Mail'];
const tierA = ['iCloud', 'Yahoo', 'Fastmail', 'Proton', 'GMX', 'Web.de', 'Posteo', 'Mailbox.org'];

const faqs = [
  {
    q: 'How do I unsubscribe from all newsletters at once?',
    a: 'Instead of clicking unsubscribe on every email, DontMailMe generates a script that runs inside your own Gmail or Outlook. It reads each newsletter\'s official <code class="inline-code">List-Unsubscribe</code> header and sends the one-click request for you, automatically. Setup takes about three minutes.',
  },
  {
    q: 'Can DontMailMe read my emails?',
    a: 'No. There is no server in the loop — the script runs entirely inside your own account, so your email and login never reach us. The code is open source, so you can verify it. We call this <strong>zero-data by design</strong>.',
  },
  {
    q: 'Is it free?',
    a: 'Completely. DontMailMe is open source (MIT) and funded by pay-what-you-want donations. Half of every donation plants trees through One Tree Planted. You never have to pay to use it.',
  },
  {
    q: 'Is it safe to unsubscribe this way?',
    a: 'Yes — safer than clicking. The script only uses the authenticated RFC 8058 <code class="inline-code">List-Unsubscribe-Post</code> header; it never clicks links in the email body, so it can\'t be lured to a tracking or phishing page. <a href="/how-it-works">See how it works</a>.',
  },
  {
    q: 'Is Unroll.me safe? Is there a private alternative?',
    a: 'Unroll.me settled FTC allegations that it misled users about sharing data derived from their inboxes, and it geo-blocks the EU. DontMailMe is the private, open-source alternative: it runs in your own cloud and never sees your data. <a href="/compare">Compare them side by side</a>.',
  },
  {
    q: 'Can an AI assistant set this up for me?',
    a: 'Yes. The scripts are exposed as plain-text endpoints (<a href="/gmail.gs"><code class="inline-code">/gmail.gs</code></a>, <a href="/outlook.ps1"><code class="inline-code">/outlook.ps1</code></a>) and there is an agent runbook at <a href="/AGENTS.md"><code class="inline-code">/AGENTS.md</code></a>, plus a real MCP server, so an agent can fetch and run the script directly.',
  },
];

const repo = 'https://github.com/sein-io/dontmailme';
const contribute = {
  provider: `${repo}/issues/new?labels=provider&title=Add%20provider%3A%20%3Cname%3E&body=Provider%20name%3A%0ADomain%3A%0AIMAP%20host%3A%0AApp-password%20URL%3A%0ARFC%208058%20support%3A`,
  translation: `${repo}/issues/new?labels=i18n&title=Add%20translation%3A%20%3Clang%3E&body=Language%3A%0ALocale%20code%3A%0AI%20can%20help%20with%3A`,
  edit: `${repo}/edit/main/src/pages/index.astro`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://dontmailme.org/#org',
      name: 'DontMailMe',
      url: 'https://dontmailme.org/',
      logo: 'https://dontmailme.org/favicon.svg',
      description:
        'Free, open-source tool that auto-unsubscribes you from newsletters using the RFC 8058 standard, running entirely inside your own cloud.',
      sameAs: ['https://github.com/sein-io/dontmailme'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://dontmailme.org/#website',
      name: 'DontMailMe',
      url: 'https://dontmailme.org/',
      publisher: { '@id': 'https://dontmailme.org/#org' },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'DontMailMe',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web-based (Gmail, Outlook, Apple Mail)',
      url: 'https://dontmailme.org/',
      description:
        'Auto-unsubscribe from newsletters you never read. A free, open-source script that runs inside your own Google or Microsoft account using the RFC 8058 one-click unsubscribe standard — our servers never see your email.',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: [
        'Automatic one-click unsubscribe (RFC 8058)',
        'Runs in your own cloud — zero data access',
        'Open source and auditable',
        'Works with Gmail, Outlook and Apple Mail',
        'Agent-ready: MCP server, AGENTS.md, raw scripts',
        'Plants trees and tracks CO2 saved',
      ],
      license: 'https://opensource.org/licenses/MIT',
      publisher: { '@id': 'https://dontmailme.org/#org' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---
<Base
  title={title}
  description={description}
  path="/"
  ctaHref="#how"
  hreflangHome={true}
  railItems={[
    { href: '#features', name: 'shield', label: 'Why' },
    { href: '#how', name: 'list', label: 'How' },
    { href: '#providers', name: 'mail', label: 'Providers' },
    { href: '#compare', name: 'scale', label: 'Compare' },
    { href: '#impact', name: 'leaf', label: 'Impact' },
    { href: '#developers', name: 'bot', label: 'Agents' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <p class="eyebrow"><span class="dot"></span> Free · Open source · Zero-data</p>
    <h1>Unsubscribe from everything you never read —<br /><span class="accent">inside your own inbox.</span></h1>
    <p class="hero-sub">
      Set it once and the newsletters you never open stop arriving — unsubscribed automatically inside
      <strong>your</strong> own Google or Microsoft account, over the official one-click standard (RFC&nbsp;8058).
      There's no DontMailMe server, so nothing ever leaves it. Read every line before you run it.
    </p>
    <div class="hero-cta">
      <a href="#how" class="btn btn-primary btn-lg">Clean my inbox</a>
      <a href="/gmail.gs" class="btn btn-lg">Read the source <Icon name="arrow" /></a>
    </div>
    <div class="hero-meta">
      <span><span class="dot"></span> No account, no card</span>
      <span><span class="dot"></span> Open-source &amp; auditable</span>
      <span><span class="dot"></span> RFC 8058 one-click</span>
      <span><span class="dot"></span> Gmail · Outlook · Apple Mail</span>
    </div>
  </section>

  <!-- ===================== Features bento ===================== -->
  <section class="sec" id="features">
    <div class="sec-h">
      <p class="sec-q">WHY US<span class="q">?</span></p>
      <h2 class="sec-t">Free email tools usually sell your inbox. We have nothing to sell.</h2>
      <p class="sec-sub">Because nothing ever leaves your account — the architecture <em>is</em> the privacy, not a promise. <span class="hint mono">hover a card for the detail</span></p>
    </div>
    <div class="bento">
      <article class="bc glass span-2 bc-reveal">
        <span class="bc-badge"><Icon name="lock" /></span>
        <div class="bc-lbl">Zero-data by design</div>
        <h3 class="bc-t">There is no server. The code runs in your account.</h3>
        <div class="bc-body"><div><p class="bc-p">
          The script lives in your own Google Apps Script or on your desktop — there is no DontMailMe backend
          that could see, store, or sell your mail. Not a privacy <em>policy</em>; an <em>architecture</em>.
          <a href="/gmail.gs">Read <code>gmail.gs</code> →</a>
        </p></div></div>
      </article>
      <article class="bc glass bc-reveal">
        <span class="bc-badge"><Icon name="book" /></span>
        <div class="bc-lbl">Open source · MIT</div>
        <h3 class="bc-t">~120 lines you can read first.</h3>
        <div class="bc-body"><div><p class="bc-p">Don't trust us — verify the code, then run it. <a href={repo}>On GitHub →</a></p></div></div>
      </article>
      <article class="bc glass bc-reveal">
        <span class="bc-badge"><Icon name="shield" /></span>
        <div class="bc-lbl">Safe by standard</div>
        <h3 class="bc-t">Only the authenticated header.</h3>
        <div class="bc-body"><div><p class="bc-p">Acts on the RFC&nbsp;8058 <code>List-Unsubscribe-Post</code> header — never clicks links in the body, so it can't be lured to a phishing page.</p></div></div>
      </article>
      <article class="bc glass span-2 bc-reveal">
        <span class="bc-badge"><Icon name="bot" /></span>
        <div class="bc-lbl">Built for humans and their agents</div>
        <h3 class="bc-t">No broker between the agent and your inbox.</h3>
        <div class="bc-body"><div><p class="bc-p">
          A single-purpose unsubscribe tool an assistant runs <em>inside your own account</em> — not one that
          OAuths your mailbox into someone's server. Ships an MCP server, <code>AGENTS.md</code> and raw scripts.
          <a href="/mcp">For developers →</a>
        </p></div></div>
      </article>
      <article class="bc glass bc-reveal">
        <span class="bc-badge"><Icon name="inbox" /></span>
        <div class="bc-lbl">Many providers</div>
        <h3 class="bc-t">Gmail, Outlook, Apple Mail &amp; more.</h3>
        <div class="bc-body"><div><p class="bc-p">Native tracks today; a generic IMAP tool for iCloud, Yahoo, GMX and others is on the roadmap.</p></div></div>
      </article>
      <article class="bc glass bc-reveal">
        <span class="bc-badge"><Icon name="leaf" /></span>
        <div class="bc-lbl">The quiet good</div>
        <h3 class="bc-t">Every cleanup plants a tree.</h3>
        <div class="bc-body"><div><p class="bc-p">Fewer emails forever means less carbon. Pay what you want; half plants a tree. <a href="/impact">See the impact →</a></p></div></div>
      </article>
    </div>
  </section>

  <!-- ===================== How it works ===================== -->
  <section class="sec" id="how">
    <div class="sec-h">
      <p class="sec-q">HOW TO</p>
      <h2 class="sec-t">Three steps, then it runs itself.</h2>
      <p class="sec-sub">No app to install, no account to create, no inbox access to grant a stranger.</p>
    </div>
    <ol class="steps">
      <li>
        <span class="step-n mono">01</span>
        <div>
          <h3 class="step-t">Copy the script</h3>
          <p class="step-p">We generate a small open-source script for your mail provider. You can read every line — nothing is hidden.</p>
        </div>
      </li>
      <li>
        <span class="step-n mono">02</span>
        <div>
          <h3 class="step-t">Paste it into your own account</h3>
          <p class="step-p">It runs in Google Apps Script (Gmail) or on your desktop (Outlook / Apple Mail). It lives in <em>your</em> cloud, not ours.</p>
        </div>
      </li>
      <li>
        <span class="step-n mono">03</span>
        <div>
          <h3 class="step-t">Relax — it runs on autopilot</h3>
          <p class="step-p">The script sends the official one-click unsubscribe for each junk newsletter and tidies your inbox. Set it once.</p>
        </div>
      </li>
    </ol>
    <div class="hero-cta" style="margin-block-start: 24px;">
      <a href="/gmail" class="btn btn-primary">Set up Gmail</a>
      <a href="/outlook" class="btn">Outlook &amp; Apple Mail</a>
    </div>
  </section>

  <!-- ===================== Providers ===================== -->
  <section class="sec" id="providers">
    <div class="sec-h">
      <p class="sec-q">WHEREVER</p>
      <h2 class="sec-t">Works with the mail you already use.</h2>
      <p class="sec-sub">Native setup tracks today; honest status badges as coverage grows.</p>
    </div>
    <div class="providers">
      {nativeProviders.map((p) => (
        <span class="prov"><Icon name="inbox" /> {p} <span class="tier">NATIVE</span></span>
      ))}
      {tierA.map((p) => (
        <span class="prov">{p} <span class="tier b">IMAP · soon</span></span>
      ))}
    </div>
    <p class="prov-note">
      A single open-source IMAP tool (zero-data, runs on your machine) will add iCloud, Yahoo, GMX, Web.de,
      Posteo, Mailbox.org and more. <a href="/providers">See all providers &amp; status →</a>
    </p>
  </section>

  <!-- ===================== Compare ===================== -->
  <section class="sec" id="compare">
    <div class="sec-h">
      <p class="sec-q">WHICH ONE<span class="q">?</span></p>
      <h2 class="sec-t">The open, private alternative to Unroll.me &amp; Cleanfox.</h2>
      <p class="sec-sub">Most unsubscribe tools are free because you are the product, or paid because privacy is sold back to you. DontMailMe is neither.</p>
    </div>
    <div class="table-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Capability</span></th>
            <th scope="col" class="us">DontMailMe</th>
            <th scope="col">Unroll.me</th>
            <th scope="col">Cleanfox</th>
            <th scope="col">Leave Me Alone</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Open source (auditable)</th><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
          <tr><th scope="row">Inbox never leaves your own cloud</th><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
          <tr><th scope="row">Sells / monetizes inbox data</th><td class="us yes">No</td><td>Yes¹</td><td>Yes²</td><td class="no">No</td></tr>
          <tr><th scope="row">Official RFC 8058 one-click</th><td class="us yes">Yes</td><td class="no">n/a</td><td class="no">n/a</td><td class="no">n/a</td></tr>
          <tr><th scope="row">Agent / MCP-ready</th><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
          <tr><th scope="row">Available in the EU</th><td class="us yes">Yes</td><td class="no">No³</td><td>Yes</td><td>Yes</td></tr>
          <tr><th scope="row">Price</th><td class="us yes">Free (PWYW)</td><td>Free</td><td>Free</td><td>Paid</td></tr>
        </tbody>
      </table>
    </div>
    <p class="compare-foot">
      ¹ In 2019 Unroll.me settled U.S. FTC allegations that it deceived users while its parent monetized
      inbox-derived data (neither admitted nor denied). ² Cleanfox is operated by Foxintelligence (now part of
      NielsenIQ), which monetizes anonymized inbox-derived data. ³ Unroll.me geo-blocks the EU/EEA.
      <a href="/compare">Full, sourced comparison →</a>
    </p>
  </section>

  <!-- ===================== Impact ===================== -->
  <section class="sec" id="impact">
    <div class="sec-h">
      <p class="sec-q">WORTH IT<span class="q">?</span></p>
      <h2 class="sec-t">See what one cleanup keeps saving.</h2>
      <p class="sec-sub">Transparent assumptions, sourced on the <a href="/impact">methodology page</a>. The good part rides along for free.</p>
    </div>
    <div class="calc">
      <div class="calc-field">
        <label for="unsub-slider">Newsletters you unsubscribe from: <span class="val" id="unsub-val">20</span></label>
        <input type="range" id="unsub-slider" min="1" max="100" value="20" step="1"
          aria-describedby="calc-metrics" />
      </div>
      <output id="calc-metrics" class="calc-metrics" aria-live="polite">
        <div class="metric"><span class="m-val tnum" id="out-emails">2,080</span><span class="m-lbl">emails you never receive / year</span></div>
        <div class="metric"><span class="m-val tnum" id="out-co2">8.3</span><span class="m-lbl">kg CO₂e prevented / year</span></div>
        <div class="metric"><span class="m-val tnum" id="out-car">52</span><span class="m-lbl">km of driving avoided</span></div>
      </output>
      <hr />
      <div class="calc-field">
        <label id="pwyw-label">Chip in what feels right — keeps it free for everyone</label>
        <div class="pwyw">
          <div class="pwyw-chips" role="group" aria-labelledby="pwyw-label">
            <button type="button" data-amt="5">€5</button>
            <button type="button" data-amt="10" aria-pressed="true">€10</button>
            <button type="button" data-amt="20">€20</button>
            <button type="button" data-amt="50">€50</button>
            <span class="pwyw-custom">€<input type="number" id="price-input" min="0" step="1" inputmode="numeric" aria-label="Custom amount in euros" placeholder="…" /></span>
          </div>
        </div>
      </div>
      <p class="calc-pledge" id="pledge" aria-live="polite">
        €10 — half funds the project, half plants 2 trees via One Tree Planted, locking in ~40 kg of CO₂ a year.
      </p>
      <a href="https://buy.stripe.com/5kQ14obKu1LTbO95oe24000" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Support &amp; plant trees</a>
      <p class="calc-fine">Pay what you want — €0 is fine too. The tool is free either way.</p>
    </div>
  </section>

  <!-- ===================== Developers ===================== -->
  <section class="sec" id="developers">
    <div class="sec-h">
      <p class="sec-q">WHAT MORE<span class="q">?</span></p>
      <h2 class="sec-t">Your AI assistant can set it up, too.</h2>
      <p class="sec-sub">A reliable, standards-based path for agents — not fragile web UIs. The whole job is one authenticated request: no body parsing, no link clicking.</p>
    </div>
    <div class="dev-grid">
      <div class="code-card" aria-hidden="false">
        <div class="code-head mono"><span class="d"></span><span class="d"></span><span class="d"></span> gmail.gs</div>
        <pre class="code-body"><code><span class="c">// RFC 8058 one-click — only on the DKIM-signed header</span>
UrlFetchApp.<span class="k">fetch</span>(postUrl, &#123;
  method: <span class="k">'post'</span>,
  contentType: <span class="k">'application/x-www-form-urlencoded'</span>,
  payload: <span class="k">'List-Unsubscribe=One-Click'</span>
&#125;);</code></pre>
      </div>
      <ul class="dev-links">
        <li><Icon name="code" /> <a href="/gmail.gs"><code>/gmail.gs</code></a> · <a href="/outlook.ps1"><code>/outlook.ps1</code></a></li>
        <li><Icon name="book" /> <a href="/AGENTS.md"><code>AGENTS.md</code></a> — a numbered runbook</li>
        <li><Icon name="list" /> <a href="/llms.txt"><code>llms.txt</code></a> — machine index</li>
        <li><Icon name="bot" /> <a href="/mcp"><code>MCP server</code></a> — call it as a tool</li>
        <li><span class="inline-code">npx -y @sein-io/dontmailme-mcp</span></li>
      </ul>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="sec" id="faq">
    <div class="sec-h">
      <div class="sec-lbl mono">07 · FAQ</div>
      <h2 class="sec-t">The things people ask before trusting a tool with their inbox.</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <div class="answer" set:html={f.a}></div>
        </details>
      ))}
    </div>
    <p class="prov-note"><a href="/faq">Read all FAQs →</a></p>
  </section>

  <!-- ===================== CTA + contribute ===================== -->
  <section class="cta">
    <h2>Stop the inflow at the source.</h2>
    <p>Free, open-source, and architecturally unable to see your data. Set it once — your inbox stays clean.</p>
    <div class="cta-row">
      <a href="/gmail" class="btn btn-primary btn-lg">Set up Gmail — ~3 min</a>
      <a href="/gmail.gs" class="btn btn-lg">Read the source <Icon name="arrow" /></a>
    </div>
    <div class="cta-row" style="margin-block-start: 20px;">
      <a href={contribute.provider} class="btn" target="_blank" rel="noopener">Add a provider</a>
      <a href={contribute.translation} class="btn" target="_blank" rel="noopener">Add a translation</a>
      <a href={contribute.edit} class="btn" target="_blank" rel="noopener">Improve this page</a>
    </div>
  </section>

  <script is:inline>
    // Impact calculator. Constants MUST match mcp/src/tools.ts and the /impact page.
    //   104 emails/yr per newsletter · 4 g CO2e/email · 0.16 kg CO2e/car-km · €5 = 1 tree · 20 kg CO2/tree/yr
    (function () {
    const EMAILS_PER_NEWSLETTER_YEAR = 104;
    const KG_CO2_PER_EMAIL = 0.004;
    const KG_CO2_PER_CAR_KM = 0.16;
    const EUR_PER_TREE = 5;
    const KG_CO2_PER_TREE_YEAR = 20;

    const $ = (id) => document.getElementById(id);
    const unsub = $('unsub-slider');

    function updateUnsub() {
      if (!unsub) return;
      const n = parseInt(unsub.value, 10);
      const emails = n * EMAILS_PER_NEWSLETTER_YEAR;
      const co2 = emails * KG_CO2_PER_EMAIL;
      $('unsub-val').textContent = String(n);
      $('out-emails').textContent = emails.toLocaleString('en-US');
      $('out-co2').textContent = co2.toFixed(1);
      $('out-car').textContent = String(Math.round(co2 / KG_CO2_PER_CAR_KM));
    }
    if (unsub) { unsub.addEventListener('input', updateUnsub); updateUnsub(); }

    // Pay-what-you-want: preset tiers + custom field (anchored, no nonsensical 0 default).
    const pledge = $('pledge');
    const custom = $('price-input');
    const chips = Array.from(document.querySelectorAll('.pwyw-chips button[data-amt]'));

    function renderDonation(eur) {
      if (!pledge) return;
      const trees = Math.floor(eur / EUR_PER_TREE);
      const co2 = trees * KG_CO2_PER_TREE_YEAR;
      if (trees < 1) {
        pledge.textContent = `€${eur} — no problem, the tool is free either way. Every €5 plants your first tree.`;
      } else {
        pledge.textContent = `€${eur} — half funds the project, half plants ${trees} tree${trees === 1 ? '' : 's'} via One Tree Planted, locking in ~${co2} kg of CO₂ a year.`;
      }
    }
    chips.forEach((btn) => btn.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      if (custom) custom.value = '';
      renderDonation(parseInt(btn.dataset.amt, 10));
    }));
    if (custom) custom.addEventListener('input', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      renderDonation(Math.max(0, parseInt(custom.value, 10) || 0));
    });
    const def = chips.find((c) => c.getAttribute('aria-pressed') === 'true') || chips[0];
    if (def) renderDonation(parseInt(def.dataset.amt, 10));
    })();
  </script>
</Base>
