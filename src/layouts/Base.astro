---
import '../styles/main.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  path?: string;          // canonical path, e.g. "/" or "/compare"
  ogImage?: string;
  showRail?: boolean;
}

const {
  title,
  description,
  path = '/',
  ogImage = '/og-image.jpg',
  showRail = true,
} = Astro.props;

const site = 'https://dontmailme.org';
const canonical = site + (path === '/' ? '/' : path);
const lang = Astro.currentLocale ?? 'en';

const railItems = [
  { href: '#features', name: 'grid', label: 'Features' },
  { href: '#how', name: 'route', label: 'How it works' },
  { href: '#providers', name: 'inbox', label: 'Providers' },
  { href: '#compare', name: 'scale', label: 'Compare' },
  { href: '#impact', name: 'leaf', label: 'Impact' },
  { href: '#developers', name: 'code', label: 'Developers' },
];

const navLinks = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/compare', label: 'Compare' },
  { href: '/mcp', label: 'Developers' },
];
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1117" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f7" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="text/markdown" href={path === '/' ? '/index.md' : path + '.md'} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site + ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + ogImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- No-flash theme: apply the saved preference before first paint. -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('sui_theme') || 'system';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'system');
      }
    })();
  </script>

  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  {showRail && (
    <aside class="rail" aria-label="Section navigation">
      <a class="ri ri-brand" href="#top" aria-label="Top">
        <Icon name="brand" class="ic ic-brand" />
      </a>
      {railItems.map((it) => (
        <a class="ri" href={it.href} title={it.label} aria-label={it.label}>
          <Icon name={it.name} />
        </a>
      ))}
      <div class="ri-spacer"></div>
      <a class="ri" href="https://github.com/sein-io/dontmailme" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener">
        <Icon name="github" />
      </a>
      <button class="ri" type="button" data-theme-toggle aria-label="Switch colour theme"></button>
    </aside>
  )}

  <div class="shell">
    <header class="hdr" id="top">
      <a class="hdr-l" href="/" aria-label="DontMailMe home">
        <Icon name="brand" class="ic ic-brand hdr-logo" />
        <span class="hdr-name">DontMailMe</span>
        <span class="hdr-ver mono">v2.0</span>
      </a>
      <div class="hdr-r">
        <nav class="hdr-nav" aria-label="Primary">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="https://github.com/sein-io/dontmailme" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch colour theme"></button>
        <a href="#how" class="btn btn-primary">Clean my inbox</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="ft-col">
        <h4>Set up</h4>
        <a href="/gmail">Gmail</a>
        <a href="/outlook">Outlook (Windows)</a>
        <a href="/outlook#apple-mail">Apple Mail (macOS)</a>
      </div>
      <div class="ft-col">
        <h4>Learn</h4>
        <a href="/how-it-works">How it works</a>
        <a href="/compare">Compare tools</a>
        <a href="/faq">FAQ</a>
        <a href="/impact">Impact &amp; methodology</a>
      </div>
      <div class="ft-col">
        <h4>For AI agents</h4>
        <a href="/llms.txt">llms.txt</a>
        <a href="/AGENTS.md">AGENTS.md</a>
        <a href="/mcp">MCP server</a>
        <a href="/gmail.gs">Raw Gmail script</a>
      </div>
      <div class="ft-col">
        <h4>Project</h4>
        <a href="https://github.com/sein-io/dontmailme" target="_blank" rel="noopener">GitHub (source)</a>
        <a href="https://github.com/sein-io/dontmailme/edit/main/src/pages/index.astro" target="_blank" rel="noopener">Improve this page</a>
        <a href="/privacy">Privacy</a>
        <a href="/imprint">Imprint</a>
      </div>
      <p class="ft-note">
        <span>A SEIN initiative · open source, zero data access.</span>
        <span class="mono">MIT · RFC&nbsp;8058</span>
      </p>
    </footer>
  </div>

  <script>
    // 3-state theme cycle (system → light → dark) + scroll-spy rail. Minimal, no deps.
    const KEY = 'sui_theme';
    const ORDER = ['system', 'light', 'dark'];

    const ICONS = {
      system: '<svg viewBox="0 0 24 24" class="ic"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
      light: '<svg viewBox="0 0 24 24" class="ic"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
      dark: '<svg viewBox="0 0 24 24" class="ic"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>',
    };
    const labels = {
      system: 'Theme: system. Switch to light.',
      light: 'Theme: light. Switch to dark.',
      dark: 'Theme: dark. Switch to system.',
    };

    const toggles = Array.from(document.querySelectorAll('[data-theme-toggle]'));

    function read() {
      try {
        const v = localStorage.getItem(KEY);
        return ORDER.includes(v) ? v : 'system';
      } catch {
        return 'system';
      }
    }
    function apply(mode) {
      document.documentElement.setAttribute('data-theme', mode);
      for (const btn of toggles) {
        btn.innerHTML = ICONS[mode];
        btn.setAttribute('aria-label', labels[mode]);
        btn.setAttribute('title', labels[mode]);
      }
    }

    let mode = read();
    apply(mode);
    for (const btn of toggles) {
      btn.addEventListener('click', () => {
        mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
        try { localStorage.setItem(KEY, mode); } catch {}
        apply(mode);
      });
    }

    // Scroll-spy: highlight the rail item for the section in view.
    const spies = Array.from(document.querySelectorAll('.rail .ri[href^="#"]'))
      .map((a) => ({ a, el: document.querySelector(a.getAttribute('href') || '') }))
      .filter((s) => s.el);

    if (spies.length) {
      const onScroll = () => {
        const y = window.scrollY + window.innerHeight * 0.35;
        let active = null;
        for (const s of spies) if (s.el && s.el.offsetTop <= y) active = s;
        for (const s of spies) s.a.classList.toggle('active', s === active);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  </script>
</body>
</html>
